{
  "info": {
    "name": "Restaurant - Chef APIs",
    "description": "Run with the Collection Runner. Creates its own chefs (random suffix) and removes them at the end.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Login as admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test(\"success is true\", () => pm.expect(j.success).to.eql(true));",
              "pm.test(\"token returned\", () => pm.expect(j.data.token).to.be.a(\"string\"));",
              "pm.collectionVariables.set(\"token\", j.data.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{ \"username\": \"{{adminUser}}\", \"password\": \"{{adminPassword}}\" }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "01 - Save one chef",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"suffix\", Date.now().toString().slice(-6));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.test(\"success is true\", () => pm.expect(j.success).to.eql(true));",
              "pm.test(\"fields saved\", () => { pm.expect(j.data.name).to.eql(\"Chef Ali \" + pm.collectionVariables.get(\"suffix\")); pm.expect(j.data.specialization).to.eql(\"Grill\"); pm.expect(j.data.facebookLink).to.eql(\"https://facebook.com/chef.ali\"); });",
              "pm.test(\"audit fields filled\", () => { pm.expect(j.data.createdDate).to.not.eql(null); pm.expect(j.data.createdBy).to.eql(pm.collectionVariables.get(\"adminUser\")); });",
              "pm.collectionVariables.set(\"chefId\", j.data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/chefs",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Chef Ali {{suffix}}\",\n  \"specialization\": \"Grill\",\n  \"logoPath\": \"/img/chef.png\",\n  \"facebookLink\": \"https://facebook.com/chef.ali\",\n  \"twitterLink\": \"https://twitter.com/chef_ali\",\n  \"instagramLink\": \"https://instagram.com/chef.ali\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "02 - Save a second chef (links are optional)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.test(\"success is true\", () => pm.expect(j.success).to.eql(true));",
              "pm.test(\"links are null\", () => { pm.expect(j.data.facebookLink).to.eql(null); pm.expect(j.data.logoPath).to.eql(null); });",
              "pm.collectionVariables.set(\"chef2Id\", j.data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/chefs",
        "body": {
          "mode": "raw",
          "raw": "{ \"name\": \"Chef Sara {{suffix}}\", \"specialization\": \"Pastry\" }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "03 - Get by id",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test(\"success is true\", () => pm.expect(j.success).to.eql(true));",
              "pm.test(\"id matches\", () => pm.expect(j.data.id).to.eql(Number(pm.collectionVariables.get(\"chefId\"))));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/chefs/{{chefId}}"
      }
    },
    {
      "name": "04 - Get by id (Arabic message)",
      "event": [
        {
          "listen": "test",
