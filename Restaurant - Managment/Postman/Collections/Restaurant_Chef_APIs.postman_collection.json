              "const j = pm.response.json();",
              "pm.test(\"Arabic success message\", () => pm.expect(j.message).to.eql(\"تم استرجاع البيانات بنجاح\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept-Language",
            "value": "ar"
          }
        ],
        "url": "{{baseUrl}}/api/chefs/{{chefId}}"
      }
    },
    {
      "name": "05 - Get all (ordered by id ASC)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test(\"success is true\", () => pm.expect(j.success).to.eql(true));",
              "pm.test(\"ordered by id ASC\", () => { const ids = j.data.content.map(c => c.id); pm.expect(ids).to.eql([...ids].sort((a, b) => a - b)); });",
              "pm.test(\"pagination metadata\", () => { pm.expect(j.data.page).to.eql(1); pm.expect(j.data).to.have.property(\"totalElements\"); pm.expect(j.data).to.have.property(\"totalPages\"); });",
              "pm.test(\"at least the 2 chefs created here\", () => pm.expect(j.data.totalElements).to.be.at.least(2));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/chefs?page=1&size=50"
      }
    },
    {
      "name": "06 - Get all with size 1 (pagination)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test(\"success is true\", () => pm.expect(j.success).to.eql(true));",
              "pm.test(\"one item per page\", () => { pm.expect(j.data.content.length).to.eql(1); pm.expect(j.data.size).to.eql(1); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/chefs?page=1&size=1"
      }
    },
    {
      "name": "07 - Update chef",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test(\"success is true\", () => pm.expect(j.success).to.eql(true));",
              "pm.test(\"fields updated\", () => { pm.expect(j.data.name).to.include(\"Updated\"); pm.expect(j.data.specialization).to.eql(\"BBQ\"); pm.expect(j.data.facebookLink).to.eql(\"http://facebook.com/ali2\"); });",
              "pm.test(\"updatedBy filled\", () => pm.expect(j.data.updatedBy).to.eql(pm.collectionVariables.get(\"adminUser\")));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/chefs",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": {{chefId}},\n  \"name\": \"Chef Ali Updated {{suffix}}\",\n  \"specialization\": \"BBQ\",\n  \"logoPath\": \"/img/chef2.png\",\n  \"facebookLink\": \"http://facebook.com/ali2\",\n  \"twitterLink\": \"https://twitter.com/ali2\",\n  \"instagramLink\": \"https://instagram.com/ali2\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
