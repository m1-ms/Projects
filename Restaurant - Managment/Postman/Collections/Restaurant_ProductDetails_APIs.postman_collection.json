              "pm.test(\"success is true\", () => pm.expect(j.success).to.eql(true));",
              "pm.test(\"fields updated\", () => { pm.expect(j.data.ingredients).to.eql(\"Beef, bun, cheddar\"); pm.expect(j.data.calories).to.eql(700); pm.expect(j.data.servingSize).to.eql(\"1 large burger\"); });",
              "pm.test(\"still linked to the same product\", () => pm.expect(j.data.productId).to.eql(Number(pm.collectionVariables.get(\"productId\"))));",
              "pm.test(\"updatedBy filled\", () => pm.expect(j.data.updatedBy).to.eql(pm.collectionVariables.get(\"adminUser\")));"
            ]
          }
        }
      ],
