    {
      "name": "10 - Get all (ordered by id ASC)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test(\"success is true\", () => pm.expect(j.success).to.eql(true));",
              "pm.test(\"ordered by id ASC\", () => { const ids = j.data.content.map(d => d.id); pm.expect(ids).to.eql([...ids].sort((a, b) => a - b)); });",
              "pm.test(\"pagination metadata\", () => { pm.expect(j.data.page).to.eql(1); pm.expect(j.data).to.have.property(\"totalElements\"); pm.expect(j.data).to.have.property(\"totalPages\"); });",
              "pm.test(\"at least the 2 records created here\", () => pm.expect(j.data.totalElements).to.be.at.least(2));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/product-details?page=1&size=50"
      }
    },
