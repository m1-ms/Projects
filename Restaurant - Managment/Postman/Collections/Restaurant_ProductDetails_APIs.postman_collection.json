    {
      "name": "05 - Add product details (all fields)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.test(\"success is true\", () => pm.expect(j.success).to.eql(true));",
              "pm.test(\"fields saved\", () => { pm.expect(j.data.ingredients).to.eql(\"Beef, bun, cheese, lettuce\"); pm.expect(j.data.calories).to.eql(650); pm.expect(j.data.preparationTimeMinutes).to.eql(15); pm.expect(j.data.servingSize).to.eql(\"1 burger\"); });",
              "pm.test(\"linked to the product\", () => pm.expect(j.data.productId).to.eql(Number(pm.collectionVariables.get(\"productId\"))));",
              "pm.test(\"product name returned\", () => pm.expect(j.data.productName).to.eql(\"Burger \" + pm.collectionVariables.get(\"suffix\")));",
              "pm.test(\"audit fields filled\", () => { pm.expect(j.data.createdDate).to.not.eql(null); pm.expect(j.data.createdBy).to.eql(pm.collectionVariables.get(\"adminUser\")); });",
              "pm.collectionVariables.set(\"detailsId\", j.data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/product-details",
        "body": {
          "mode": "raw",
          "raw": "{ \"productId\": {{productId}}, \"ingredients\": \"Beef, bun, cheese, lettuce\", \"calories\": 650, \"preparationTimeMinutes\": 15, \"servingSize\": \"1 burger\" }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
