              "pm.test(\"two items saved\", () => pm.expect(j.data.length).to.eql(2));",
              "pm.collectionVariables.set(\"soupsId\", j.data[0].id);",
              "pm.collectionVariables.set(\"pastaId\", j.data[1].id);"
            ]
