        "url": "{{baseUrl}}/api/categories/1"
      }
    },
    {
      "name": "04 - Save one (Salads)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"suffix\", Date.now().toString().slice(-6));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.test(\"success is true\", () => pm.expect(j.success).to.eql(true));",
              "pm.test(\"name saved\", () => pm.expect(j.data.name).to.eql(\"Salads \" + pm.collectionVariables.get(\"suffix\")));",
              "pm.test(\"audit fields filled\", () => { pm.expect(j.data.createdDate).to.not.eql(null); pm.expect(j.data.createdBy).to.eql(pm.collectionVariables.get(\"adminUser\")); });",
              "pm.collectionVariables.set(\"saladsId\", j.data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/categories",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Salads {{suffix}}\",\n  \"logo\": \"fa fa-leaf\",\n  \"flag\": \"Special\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
