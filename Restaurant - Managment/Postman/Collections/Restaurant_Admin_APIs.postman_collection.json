    {
      "name": "D01 - Dashboard: structure and ordering",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test(\"success is true\", () => pm.expect(j.success).to.eql(true));",
              "pm.test(\"totals\", () => { const t = j.data.totals; [\"categories\", \"products\", \"chefs\", \"users\", \"orders\"].forEach(k => pm.expect(t[k]).to.be.a(\"number\")); pm.expect(t.users).to.be.at.least(3); });",
              "pm.test(\"at most 5 recent items, newest first\", () => { [\"recentOrders\", \"recentProducts\", \"recentCategories\"].forEach(k => { const list = j.data[k]; pm.expect(list.length).to.be.at.most(5); const ids = list.map(x => x.id); pm.expect(ids).to.eql([...ids].sort((a, b) => b - a)); }); });",
              "pm.test(\"recent orders carry the owner and the total\", () => j.data.recentOrders.forEach(o => { pm.expect(o.code).to.match(/^ORD-/); pm.expect(o.username).to.be.a(\"string\"); pm.expect(o.totalPrice).to.be.a(\"number\"); }));",
              "pm.collectionVariables.set(\"before\", JSON.stringify(j.data.totals));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/admin/dashboard"
      }
    },
