              "pm.test(\"the newest product is first, with its category\", () => { const p = j.data.recentProducts[0]; pm.expect(p.id).to.eql(Number(pm.collectionVariables.get(\"prodId\"))); pm.expect(p.categoryName).to.eql(\"AdmDash Cat \" + pm.collectionVariables.get(\"suffix\")); pm.expect(p.price).to.eql(4.5); });"
