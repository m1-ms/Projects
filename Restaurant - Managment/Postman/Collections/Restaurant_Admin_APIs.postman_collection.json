{
  "info": {
    "name": "Restaurant - Admin APIs (Users and Dashboard)",
    "description": "Creates two users (random suffix; there is no delete-user API, see the cleanup SQL) plus a temporary category and product that it removes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "00 - Login as admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test(\"success is true\", () => pm.expect(j.success).to.eql(true));",
              "pm.collectionVariables.set(\"token\", j.data.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{ \"username\": \"{{adminUser}}\", \"password\": \"{{adminPassword}}\" }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "01 - Setup: sign up user A",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"suffix\", Date.now().toString().slice(-6));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.collectionVariables.set(\"userAId\", j.data.id);",
              "pm.collectionVariables.set(\"userA\", j.data.username);",
              "pm.collectionVariables.set(\"userAUpper\", j.data.username.toUpperCase());",
              "pm.collectionVariables.set(\"today\", j.data.createdDate.substring(0, 10));",
              "const d = new Date(j.data.createdDate.substring(0, 10) + \"T00:00:00Z\"); d.setUTCDate(d.getUTCDate() + 1); pm.collectionVariables.set(\"tomorrow\", d.toISOString().substring(0, 10));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/signup",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{ \"username\": \"admusera{{suffix}}\", \"password\": \"Passw0rd!\", \"age\": 30, \"phoneNumber\": \"+201000000001\", \"address\": \"Cairo\" }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "02 - Setup: sign up user B (no phone)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.collectionVariables.set(\"userBId\", j.data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/signup",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{ \"username\": \"admuserb{{suffix}}\", \"password\": \"Passw0rd!\", \"age\": 40 }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "03 - Setup: log in user A",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.collectionVariables.set(\"tokenA\", j.data.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{ \"username\": \"{{userA}}\", \"password\": \"Passw0rd!\" }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "U01 - List users (paginated, ordered by id)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test(\"success is true\", () => pm.expect(j.success).to.eql(true));",
              "pm.test(\"ordered by id ASC\", () => { const ids = j.data.content.map(o => o.id); pm.expect(ids).to.eql([...ids].sort((a, b) => a - b)); });",
              "pm.test(\"the password is never returned\", () => pm.expect(j.data.content.every(u => !(\"password\" in u))).to.eql(true));",
              "pm.test(\"the admin is listed with both roles\", () => { const a = j.data.content.find(u => u.username === pm.collectionVariables.get(\"adminUser\")); pm.expect(a).to.not.eql(undefined); pm.expect(a.roles).to.eql([\"ADMIN\", \"USER\"]); });",
              "pm.test(\"at least admin, A and B\", () => pm.expect(j.data.totalElements).to.be.at.least(3));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/admin/users?page=1&size=50"
      }
    },
    {
      "name": "U02 - Search by key",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test(\"success is true\", () => pm.expect(j.success).to.eql(true));",
              "pm.test(\"exactly 2 users\", () => pm.expect(j.data.totalElements).to.eql(2));",
              "pm.test(\"ordered by id ASC\", () => { const ids = j.data.content.map(o => o.id); pm.expect(ids).to.eql([...ids].sort((a, b) => a - b)); });",
              "pm.test(\"the password is never returned\", () => pm.expect(j.data.content.every(u => !(\"password\" in u))).to.eql(true));",
              "pm.test(\"contains the expected users\", () => { const ids = j.data.content.map(o => o.id); pm.expect(ids).to.include(Number(pm.collectionVariables.get(\"userAId\"))); pm.expect(ids).to.include(Number(pm.collectionVariables.get(\"userBId\"))); });",
              "pm.test(\"details and roles are returned\", () => { const a = j.data.content.find(u => u.id === Number(pm.collectionVariables.get(\"userAId\"))); pm.expect(a.roles).to.eql([\"USER\"]); pm.expect(a.age).to.eql(30); pm.expect(a.phoneNumber).to.eql(\"+201000000001\"); pm.expect(a.address).to.eql(\"Cairo\"); const b = j.data.content.find(u => u.id === Number(pm.collectionVariables.get(\"userBId\"))); pm.expect(b.phoneNumber).to.eql(null); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/admin/users?key={{suffix}}&page=1&size=50"
      }
    },
