      }
    },
    {
      "name": "U04 - Filter by role ADMIN",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test(\"success is true\", () => pm.expect(j.success).to.eql(true));",
              "pm.test(\"every user is an admin\", () => pm.expect(j.data.content.every(u => u.roles.includes(\"ADMIN\"))).to.eql(true));",
              "pm.test(\"the admin account is listed\", () => pm.expect(j.data.content.some(u => u.username === pm.collectionVariables.get(\"adminUser\"))).to.eql(true));",
              "pm.test(\"does not contain other users\", () => { const ids = j.data.content.map(o => o.id); pm.expect(ids).to.not.include(Number(pm.collectionVariables.get(\"userAId\"))); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/admin/users?role=ADMIN&page=1&size=50"
      }
