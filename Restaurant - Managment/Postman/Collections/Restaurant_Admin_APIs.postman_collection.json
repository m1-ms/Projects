              "pm.test(\"exactly 1 users\", () => pm.expect(j.data.totalElements).to.eql(1));",
              "pm.test(\"contains the expected users\", () => { const ids = j.data.content.map(o => o.id); pm.expect(ids).to.include(Number(pm.collectionVariables.get(\"userAId\"))); });"
            ]
          }
        }
