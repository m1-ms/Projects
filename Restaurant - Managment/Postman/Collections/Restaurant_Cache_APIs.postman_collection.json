{
  "info": {
    "name": "Restaurant - Redis Cache APIs (stale data checks)",
    "description": "Fills the cache with a read, changes the data, then reads again and expects the new data. Creates one user (no delete-user API) and removes everything else.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "00 - Login as admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test(\"success is true\", () => pm.expect(j.success).to.eql(true));",
              "pm.collectionVariables.set(\"token\", j.data.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{ \"username\": \"{{adminUser}}\", \"password\": \"{{adminPassword}}\" }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "K01 - Create a category",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"suffix\", Date.now().toString().slice(-6));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.collectionVariables.set(\"catId\", j.data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/categories",
        "body": {
          "mode": "raw",
          "raw": "{ \"name\": \"CacheTest Cat {{suffix}}\", \"logo\": \"fa fa-utensils\", \"flag\": \"Special\" }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "K02 - Read it by id (fills the cache)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test(\"original name\", () => pm.expect(j.data.name).to.eql(\"CacheTest Cat \" + pm.collectionVariables.get(\"suffix\")));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/categories/{{catId}}"
      }
    },
    {
      "name": "K03 - Read it again (served from the cache)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test(\"same name\", () => pm.expect(j.data.name).to.eql(\"CacheTest Cat \" + pm.collectionVariables.get(\"suffix\")));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/categories/{{catId}}"
      }
    },
    {
      "name": "K04 - Search by key (fills the cache)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test(\"one result\", () => pm.expect(j.data.totalElements).to.eql(1));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/categories/search?key=CacheTest%20Cat%20{{suffix}}"
      }
    },
