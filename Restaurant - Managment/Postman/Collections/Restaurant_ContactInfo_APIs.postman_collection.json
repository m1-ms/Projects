{
  "info": {
    "name": "Restaurant - ContactInfo APIs",
    "description": "Run with the Collection Runner. Creates its own records (random suffix) and removes them at the end.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Login as admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test(\"success is true\", () => pm.expect(j.success).to.eql(true));",
              "pm.test(\"token returned\", () => pm.expect(j.data.token).to.be.a(\"string\"));",
              "pm.collectionVariables.set(\"token\", j.data.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{ \"username\": \"{{adminUser}}\", \"password\": \"{{adminPassword}}\" }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "01 - Save contact information",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"suffix\", Date.now().toString().slice(-6));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.test(\"success is true\", () => pm.expect(j.success).to.eql(true));",
              "pm.test(\"fields saved\", () => { pm.expect(j.data.name).to.eql(\"Visitor \" + pm.collectionVariables.get(\"suffix\")); pm.expect(j.data.email).to.include(\"+menu@example.com\"); pm.expect(j.data.subject).to.eql(\"Table reservation\"); });",
              "pm.test(\"audit fields filled\", () => { pm.expect(j.data.createdDate).to.not.eql(null); pm.expect(j.data.createdBy).to.eql(pm.collectionVariables.get(\"adminUser\")); });",
              "pm.test(\"sender is the logged-in user\", () => { pm.expect(j.data.username).to.eql(pm.collectionVariables.get(\"adminUser\")); pm.expect(j.data.userId).to.be.a(\"number\"); });",
              "pm.collectionVariables.set(\"contactId\", j.data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/contact-info",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Visitor {{suffix}}\",\n  \"email\": \"visitor{{suffix}}+menu@example.com\",\n  \"subject\": \"Table reservation\",\n  \"message\": \"I would like to book a table for four.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "02 - Save contact information with Arabic text",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.test(\"success is true\", () => pm.expect(j.success).to.eql(true));",
              "pm.test(\"Arabic text stored correctly\", () => { pm.expect(j.data.name).to.eql(\"زائر \" + pm.collectionVariables.get(\"suffix\")); pm.expect(j.data.subject).to.eql(\"حجز طاولة\"); });",
              "pm.collectionVariables.set(\"contact2Id\", j.data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/contact-info",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"زائر {{suffix}}\",\n  \"email\": \"arabic{{suffix}}@example.com\",\n  \"subject\": \"حجز طاولة\",\n  \"message\": \"أود حجز طاولة لأربعة أشخاص مساء الجمعة.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "03 - Get by id",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test(\"success is true\", () => pm.expect(j.success).to.eql(true));",
              "pm.test(\"id matches\", () => pm.expect(j.data.id).to.eql(Number(pm.collectionVariables.get(\"contactId\"))));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/contact-info/{{contactId}}"
      }
    },
