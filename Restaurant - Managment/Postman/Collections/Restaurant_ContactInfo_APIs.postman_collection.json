              "const j = pm.response.json();",
              "pm.test(\"success is true\", () => pm.expect(j.success).to.eql(true));",
              "pm.test(\"only the logged-in user messages, including the new one\", () => { pm.expect(j.data.content.every(c => c.username === pm.collectionVariables.get(\"adminUser\"))).to.eql(true); pm.expect(j.data.content.some(c => c.id === Number(pm.collectionVariables.get(\"contactId\")))).to.eql(true); });",
              "pm.test(\"ordered by id ASC\", () => { const ids = j.data.content.map(c => c.id); pm.expect(ids).to.eql([...ids].sort((a, b) => a - b)); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/contact-info/my?page=1&size=50"
