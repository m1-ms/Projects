{
  "info": {
    "name": "Restaurant - Product APIs",
    "description": "Run with the Collection Runner. It creates its own categories (random suffix) and removes everything at the end.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Login as admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test(\"success is true\", () => pm.expect(j.success).to.eql(true));",
              "pm.test(\"token returned\", () => pm.expect(j.data.token).to.be.a(\"string\"));",
              "pm.collectionVariables.set(\"token\", j.data.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{ \"username\": \"{{adminUser}}\", \"password\": \"{{adminPassword}}\" }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "01 - Setup: create category A",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"suffix\", Date.now().toString().slice(-6));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.collectionVariables.set(\"catId\", j.data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/categories",
        "body": {
          "mode": "raw",
          "raw": "{ \"name\": \"Menu A {{suffix}}\", \"logo\": \"fa fa-utensils\", \"flag\": \"Special\" }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "02 - Setup: create category B",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.collectionVariables.set(\"cat2Id\", j.data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/categories",
        "body": {
          "mode": "raw",
          "raw": "{ \"name\": \"Menu B {{suffix}}\", \"logo\": \"fa fa-utensils\", \"flag\": \"Special\" }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "03 - Save one product",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.test(\"success is true\", () => pm.expect(j.success).to.eql(true));",
              "pm.test(\"price saved\", () => pm.expect(j.data.price).to.eql(9.5));",
              "pm.test(\"category name returned\", () => pm.expect(j.data.categoryName).to.eql(\"Menu A \" + pm.collectionVariables.get(\"suffix\")));",
              "pm.test(\"audit fields filled\", () => { pm.expect(j.data.createdDate).to.not.eql(null); pm.expect(j.data.createdBy).to.eql(pm.collectionVariables.get(\"adminUser\")); });",
              "pm.collectionVariables.set(\"productId\", j.data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/products",
        "body": {
          "mode": "raw",
          "raw": "{ \"name\": \"Burger {{suffix}}\", \"imagePath\": \"/img/x.png\", \"description\": \"Sample description\", \"price\": 9.5, \"categoryId\": {{catId}} }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "04 - Save list (2 products)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.test(\"success is true\", () => pm.expect(j.success).to.eql(true));",
              "pm.test(\"two products saved\", () => pm.expect(j.data.length).to.eql(2));",
              "pm.collectionVariables.set(\"p2Id\", j.data[0].id);",
              "pm.collectionVariables.set(\"p3Id\", j.data[1].id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/products/bulk",
        "body": {
          "mode": "raw",
          "raw": "[\n  { \"name\": \"Pizza {{suffix}}\", \"imagePath\": \"/img/x.png\", \"description\": \"Sample description\", \"price\": 11, \"categoryId\": {{catId}} },\n  { \"name\": \"Cake {{suffix}}\", \"imagePath\": \"/img/x.png\", \"description\": \"Sample description\", \"price\": 6.5, \"categoryId\": {{catId}} }\n]",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "05 - Get by id",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test(\"success is true\", () => pm.expect(j.success).to.eql(true));",
              "pm.test(\"id matches\", () => pm.expect(j.data.id).to.eql(Number(pm.collectionVariables.get(\"productId\"))));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/products/{{productId}}"
      }
    },
    {
      "name": "06 - Get all (ordered by id ASC)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test(\"success is true\", () => pm.expect(j.success).to.eql(true));",
              "pm.test(\"ordered by id ASC\", () => { const ids = j.data.content.map(p => p.id); pm.expect(ids).to.eql([...ids].sort((a, b) => a - b)); });",
              "pm.test(\"pagination metadata\", () => { pm.expect(j.data.page).to.eql(1); pm.expect(j.data).to.have.property(\"totalElements\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/products?page=1&size=50"
      }
    },
    {
      "name": "07 - Get by category",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test(\"success is true\", () => pm.expect(j.success).to.eql(true));",
              "pm.test(\"3 products\", () => pm.expect(j.data.totalElements).to.eql(3));",
              "pm.test(\"all belong to the category\", () => pm.expect(j.data.content.every(p => p.categoryId === Number(pm.collectionVariables.get(\"catId\")))).to.eql(true));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/products/category/{{catId}}"
      }
    },
    {
      "name": "08 - Update one (change price and move to category B)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test(\"success is true\", () => pm.expect(j.success).to.eql(true));",
              "pm.test(\"price updated\", () => pm.expect(j.data.price).to.eql(12.75));",
              "pm.test(\"moved to category B\", () => pm.expect(j.data.categoryId).to.eql(Number(pm.collectionVariables.get(\"cat2Id\"))));",
              "pm.test(\"updatedBy filled\", () => pm.expect(j.data.updatedBy).to.eql(pm.collectionVariables.get(\"adminUser\")));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/products",
        "body": {
          "mode": "raw",
          "raw": "{ \"id\": {{productId}}, \"name\": \"Burger Deluxe {{suffix}}\", \"imagePath\": \"/img/x.png\", \"description\": \"Updated\", \"price\": 12.75, \"categoryId\": {{cat2Id}} }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "09 - Update list (Pizza moves to category B)",
